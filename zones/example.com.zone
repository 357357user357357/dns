$ORIGIN example.com.
$TTL 3600
@       IN  SOA ns1.example.com. hostmaster.example.com. (
                2026100901 ; serial YYYYMMDDnn
                7200       ; refresh
                3600       ; retry
                1209600    ; expire
                3600 )     ; minimum
@       IN  NS  ns1.example.com.
@       IN  NS  ns2.example.com.
; glue for in-zone nameservers
ns1     IN  A   192.0.2.53
ns2     IN  A   192.0.2.154
; service records
@       IN  A   192.0.2.10
www     IN  A   192.0.2.10
